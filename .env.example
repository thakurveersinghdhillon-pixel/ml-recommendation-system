# MovieLens Recommendation System Environment Variables Example

# PostgreSQL Database Credentials (used by Docker Compose & local setup)
POSTGRES_DB=ml_recommendations
POSTGRES_USER=ml_app
POSTGRES_PASSWORD=change_me_in_production

# Backend Database Connection URL
# For Docker Compose internal networking:
DATABASE_URL=postgresql+psycopg://ml_app:change_me_in_production@db:5432/ml_recommendations
# For local development outside Docker:
# DATABASE_URL=postgresql+psycopg://thakurveersingh@localhost:5432/ml_recommendations

# Database Pool Settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Backend & Frontend Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend API URL Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
